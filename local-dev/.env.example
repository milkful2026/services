# Copy to local-dev/.env (gitignored) and fill in your Razorpay test-mode
# keys (Dashboard → Settings → API Keys, test mode). docker compose reads
# local-dev/.env automatically and passes these to the `payment` service.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Only needed to verify real Razorpay webhooks, which can't reach
# localhost without a tunnel — the reconcile sweep confirms payments anyway.
RAZORPAY_WEBHOOK_SECRET=
