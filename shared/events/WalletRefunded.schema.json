{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milkful.internal/events/WalletRefunded.schema.json",
  "title": "WalletRefunded",
  "description": "EventBridge `detail` for an order refund credited back to the wallet (a `REFUND` ledger entry against an earlier ORDER_DEBIT). Producer: milkful.wallet (MA-153). Consumers: Notification Service (future, MA-103); Reporting (future, MA-104). A separate event from WalletCredited, which pins type RECHARGE and requires paymentId.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "occurredAt",
    "correlationId",
    "userId",
    "walletId",
    "orderId",
    "refundId",
    "amountPaise",
    "balanceAfterPaise",
    "ref"
  ],
  "properties": {
    "eventId": { "type": "string", "minLength": 1, "description": "Dedupe key for consumers." },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "userId": { "type": "string", "minLength": 1, "description": "Cognito sub." },
    "walletId": { "type": "string", "minLength": 1 },
    "orderId": { "type": "string", "minLength": 1 },
    "refundId": { "type": "string", "minLength": 1, "description": "Caller-chosen; MA-32 always sends `cancel`." },
    "amountPaise": { "type": "integer", "exclusiveMinimum": 0 },
    "balanceAfterPaise": { "type": "integer", "minimum": 0 },
    "ref": { "type": "string", "minLength": 1, "description": "The ledger ref, `refund:{orderId}:{refundId}`." }
  }
}
