{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milkful.internal/events/WalletLowBalance.schema.json",
  "title": "WalletLowBalance",
  "description": "EventBridge `detail` for a wallet balance dropping under the recharge-reminder threshold after a debit, or a debit being refused for insufficient balance. Producer: milkful.wallet (MA-130). Consumers: Notification Service (future); Reporting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "occurredAt",
    "userId",
    "walletId",
    "balancePaise",
    "thresholdPaise",
    "reason"
  ],
  "properties": {
    "eventId": { "type": "string", "minLength": 1, "description": "Dedupe key for consumers." },
    "occurredAt": { "type": "string", "format": "date-time" },
    "userId": { "type": "string", "minLength": 1, "description": "Cognito sub." },
    "walletId": { "type": "string", "minLength": 1 },
    "balancePaise": { "type": "integer", "minimum": 0 },
    "thresholdPaise": { "type": "integer", "exclusiveMinimum": 0 },
    "reason": { "type": "string", "enum": ["LOW_AFTER_DEBIT", "DEBIT_REFUSED"] }
  }
}
